{
  "name": "local-first-pdf-assistant",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.folio.config.ts --configLoader runner",
    "build": "tsc -b && vite build --config vite.folio.config.ts --configLoader runner",
    "build:quick-index": "node scripts/build-quick-index.mjs",
    "test": "vitest run",
    "evaluate": "vitest run src/lib/evaluation.test.ts --reporter=verbose",
    "preview": "vite preview"
  },
  "dependencies": {
    "@mlc-ai/web-llm": "^0.2.80",
    "lucide-react": "^0.468.0",
    "pdfjs-dist": "^4.10.38",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tesseract.js": "^6.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "fake-indexeddb": "^6.0.0",
    "typescript": "~5.7.2",
    "vite": "^6.0.5",
    "vitest": "^4.1.12"
  }
}
